NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Email notifications (Resend — https://resend.com)
RESEND_API_KEY=re_your-resend-api-key
# "From" address — must match a verified domain in your Resend account
# Use "Interleaf <noreply@resend.dev>" for testing on the free tier
RESEND_FROM_ADDRESS=Interleaf <noreply@resend.dev>

# Cron job — any random secret string (e.g. openssl rand -hex 32)
# Vercel injects this automatically into cron requests; set the same value in Vercel env vars
CRON_SECRET=your-cron-secret

# Supabase service role key — bypasses RLS; used only in server-side cron/admin routes
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public URL of the deployed app (used for links inside emails)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
